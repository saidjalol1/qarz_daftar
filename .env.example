# =============================================================================
# QARZ DAFTAR - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# IMPORTANT: Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
#
# Production Checklist:
# ✓ Generate new SECRET_KEY
# ✓ Set DEBUG=False
# ✓ Configure ALLOWED_HOSTS
# ✓ Set up proper database
# ✓ Configure email settings
# ✓ Enable HTTPS settings
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SETTINGS
# -----------------------------------------------------------------------------

# Django Secret Key - MUST BE UNIQUE AND SECRET IN PRODUCTION
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-use-strong-random-secret

# Debug Mode - MUST BE False IN PRODUCTION
# Set to False for production deployments
DEBUG=False

# Allowed Hosts - Comma-separated list of domains
# Examples: yourapp.com,www.yourapp.com,api.yourapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Database URL format: engine://user:password@host:port/database
# 
# SQLite (Development):
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL (Production Recommended):
# DATABASE_URL=postgresql://username:password@localhost:5432/qarz_daftar
#
# MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/qarz_daftar
DATABASE_URL=sqlite:///db.sqlite3

# -----------------------------------------------------------------------------
# SECURITY SETTINGS (PRODUCTION)
# -----------------------------------------------------------------------------

# HTTPS/SSL Settings - Set to True if using HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security) - Seconds to remember HTTPS
# Recommended: 31536000 (1 year) for production
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Security Headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------

# Email Backend
# Development: django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (for production email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Default From Email
DEFAULT_FROM_EMAIL=noreply@qarz-daftar.uz
SERVER_EMAIL=admin@qarz-daftar.uz

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION
# -----------------------------------------------------------------------------

# Session timeout in seconds (86400 = 24 hours)
SESSION_COOKIE_AGE=86400

# Session cookie settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_SAVE_EVERY_REQUEST=False

# -----------------------------------------------------------------------------
# CSRF CONFIGURATION
# -----------------------------------------------------------------------------

# CSRF token settings
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_SAMESITE=Lax
CSRF_USE_SESSIONS=False

# CSRF trusted origins (for production with HTTPS)
# CSRF_TRUSTED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# -----------------------------------------------------------------------------
# STATIC & MEDIA FILES
# -----------------------------------------------------------------------------

# Static files URL
STATIC_URL=/static/

# Static files root (for collectstatic)
STATIC_ROOT=/var/www/qarz_daftar/static/

# Media files (user uploads)
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/qarz_daftar/media/

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/var/log/qarz_daftar/app.log

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Default language
LANGUAGE_CODE=uz

# Timezone
TIME_ZONE=Asia/Tashkent

# Default currency (uzs or usd)
DEFAULT_CURRENCY=uzs

# CBU (Central Bank of Uzbekistan) API URL
CBU_EXCHANGE_RATE_API=https://cbu.uz/uz/arkhiv-kursov-valyut/json/USD/

# Exchange rate update interval in minutes
EXCHANGE_RATE_UPDATE_INTERVAL=10

# -----------------------------------------------------------------------------
# RATE LIMITING (OPTIONAL)
# -----------------------------------------------------------------------------

# Enable rate limiting
RATELIMIT_ENABLE=True

# Cache backend for rate limiting
RATELIMIT_USE_CACHE=default

# -----------------------------------------------------------------------------
# BACKUP SETTINGS (OPTIONAL)
# -----------------------------------------------------------------------------

# Database backup directory
BACKUP_DIR=/var/backups/qarz_daftar/

# Backup retention days
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (OPTIONAL)
# -----------------------------------------------------------------------------

# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS (ONLY FOR DEVELOPMENT)
# -----------------------------------------------------------------------------

# Show debug toolbar (development only)
SHOW_DEBUG_TOOLBAR=False

# Seed database with sample data
SEED_SAMPLE_DATA=False

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
